<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RootNamespace>bam.blobs</RootNamespace>
        <IntermediatePackDir Condition=" '$(OS)' == 'Windows_NT' ">$(HOMEDRIVE)$(HOMEPATH)/.bam/build/pack/$(Configuration)/$(MSBuildThisFileName)/</IntermediatePackDir>
        <IntermediatePackDir Condition=" '$(OS)' == 'UNIX' ">$(HOME)/.bam/build/pack/$(Configuration)/$(MSBuildThisFileName)/</IntermediatePackDir>
    </PropertyGroup>
    <PropertyGroup>
        <OutputPath Condition=" '$(OS)' == 'Windows_NT' ">$(HOMEDRIVE)$(HOMEPATH)\.bam\build\$(Configuration)\$(MSBuildThisFileName)\</OutputPath>
        <OutputPath Condition=" '$(OS)' == 'UNIX' ">$(HOME)\.bam\build\$(Configuration)\$(MSBuildThisFileName)\</OutputPath>
    </PropertyGroup>
    
    <ItemGroup>
      <ProjectReference Include="$(BamFrameworkRoot)bam.application\bam.application\bam.application.csproj" />
      <ProjectReference Include="$(BamFrameworkRoot)bam.base\bam.base\bam.base.csproj" />
      <ProjectReference Include="$(BamFrameworkRoot)bam.configuration\bam.configuration\bam.configuration.csproj" />
      <ProjectReference Include="$(BamFrameworkRoot)bam.data.repositories\bam.data.repositories\bam.data.repositories.csproj" />
      <ProjectReference Include="$(BamFrameworkRoot)bam.data.schema\bam.data.schema\bam.data.schema.csproj" />
      <ProjectReference Include="$(BamFrameworkRoot)bam.data\bam.data.config\bam.data.config.csproj" />
      <ProjectReference Include="$(BamFrameworkRoot)bam.data\bam.data.firebird\bam.data.firebird.csproj" />
      <ProjectReference Include="$(BamFrameworkRoot)bam.data\bam.data.mssql\bam.data.mssql.csproj" />
      <ProjectReference Include="$(BamFrameworkRoot)bam.data\bam.data.mysql\bam.data.mysql.csproj" />
      <ProjectReference Include="$(BamFrameworkRoot)bam.data\bam.data.oracle\bam.data.oracle.csproj" />
      <ProjectReference Include="$(BamFrameworkRoot)bam.data\bam.data.postgres\bam.data.postgres.csproj" />
      <ProjectReference Include="$(BamFrameworkRoot)bam.data\bam.data\bam.data.csproj" />
      <ProjectReference Include="$(BamFrameworkRoot)bam.encryption\bam.encryption\bam.encryption.csproj" />
      <ProjectReference Include="$(BamFrameworkRoot)bam.generators\bam.generators\bam.generators.csproj" />
      <ProjectReference Include="$(BamFrameworkRoot)bam.logging\bam.logging\bam.logging.csproj" />
      <ProjectReference Include="..\..\bam.storage\bam.storage\bam.storage.csproj" />
    </ItemGroup>

    <ItemGroup>
      <Compile Remove="FileService.cs" />
      <Compile Remove="FileServiceSettings.cs" />
      <Compile Remove="IFileService.cs" />
      <Compile Remove="FileWriter.cs" />
      <Compile Remove="OpaqueChunkStorage.cs" />
      <Compile Remove="IHmacKeyProvider.cs" />
    </ItemGroup>

    <ItemGroup>
      <Folder Include=".bam\" />
      <Folder Include=".bam\sh\Templates\" />
    </ItemGroup>

    <ItemGroup>
      <None Include=".bam\sh\DaoRepoGenerationConfig.yaml" />
      <None Include=".bam\sh\delete-dev-sys-dbs.sh" />
      <None Include=".bam\sh\regen-data-access.sh" />
    </ItemGroup>

    <ItemGroup>
      <Content Include=".bam\sh\export-dotnet-root.sh" />
    </ItemGroup>

</Project>
